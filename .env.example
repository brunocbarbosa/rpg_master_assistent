# Copie este arquivo para `.env` e ajuste conforme o seu ambiente.
# O arquivo `.env` NUNCA deve ser versionado (está no .gitignore).

# Endereço do servidor Ollama (não requer chave de API).
# Padrão local: http://localhost:11434
# No WSL2 com o Ollama rodando no host Windows, deixe comentado: o app detecta o
# IP do host (gateway padrão do WSL) automaticamente. Para fixar manualmente:
#   OLLAMA_HOST=http://172.20.0.1:11434

# Modelo a ser utilizado no Ollama (ex.: mistral, mistral-small, mistral-nemo).
OLLAMA_MODEL=mistral
